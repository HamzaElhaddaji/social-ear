# Docker Compose and local CLI launches read .env; existing process variables win.
POSTGRES_PASSWORD=replace-with-a-long-random-password
PUBLIC_ORIGIN=http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1
COOKIE_SECURE=0
ALLOW_REGISTRATION=1
ENABLE_BLUESKY=0
ENABLE_MASTODON=0
MASTODON_TOKEN=
ENABLE_YOUTUBE=0
YOUTUBE_API_KEY=
SENTIMENT_PROVIDER=baseline
INSTALL_MODELS=0
RESEARCH_PROVIDER=extractive
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_URL=http://127.0.0.1:11434
# Local default is sqlite:///data/platform.db
# DATABASE_URL=postgresql+psycopg://socialear:password@localhost:5432/socialear
