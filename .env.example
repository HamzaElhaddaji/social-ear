# Docker Compose reads .env. Local Python runs read environment variables set in your shell.
POSTGRES_PASSWORD=replace-with-a-long-random-password
PUBLIC_ORIGIN=http://localhost:8000
ALLOWED_HOSTS=localhost,127.0.0.1
COOKIE_SECURE=0
ALLOW_REGISTRATION=1
ENABLE_BLUESKY=0
SENTIMENT_PROVIDER=baseline
INSTALL_MODELS=0
# Local default is sqlite:///data/platform.db
# DATABASE_URL=postgresql+psycopg://socialear:password@localhost:5432/socialear
